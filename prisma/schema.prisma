// 設計_Supabaseスキーマ_luck428移行_v1.md §2 を正とする
// （形はFirestoreの現行スキーマを忠実に写す＝正規化しない）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Business {
  realestate
  legal
  labor
}

enum ColumnStatus {
  draft
  published
  deleted
}

model Column {
  id           String       @id @default(uuid())
  business     Business
  slug         String
  title        String
  date         String // ISO文字列のまま維持（設計書§1：挙動を変えない）
  category     String
  excerpt      String       @db.Text
  content      String       @db.Text
  status       ColumnStatus @default(draft)
  modifiedDate String?      @map("modified_date")
  ogImage      String?      @map("og_image")
  author       Json? // { name, title }
  keywords     String[]     @default([])
  faq          Json? // [{ question, answer }]
  tags         String[]     @default([])
  locales      String[]     @default([]) // 空配列＝全言語公開（設計書§2.4）
  translations Json? // { en?, "zh-tw"?, zh? } 各 ColumnTranslation
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([business, slug]) // upsertColumnBySlug の冪等性をDB制約で保証
  @@index([business, status, date(sort: Desc)]) // 一覧・sitemap用
  @@map("columns")
}

enum PropertyStatus {
  draft
  published
  closed
}

// 物件の種別（不動産の表示に関する公正競争規約 施行規則第3条の区分に対応）
// land=別表3（売地1区画）／house=別表5（新築・中古住宅1戸）／condo=別表7（中古マンション等1戸）
// wholeBuilding=別表5（一棟売りマンション・アパート）／businessBuilding=事業用建物（専用別表なし・
// 別表5相当の自主基準表示＝2026-09-01浦松承認①）。賃貸の将来拡張はこのenumへ追加する。
enum PropertyDealType {
  land
  house
  condo
  wholeBuilding
  businessBuilding
  rental
}

// 掲載カテゴリ（勝ち筋対応）：gh=障害福祉GH向け／jigyo=事業用・店舗／souzoku=相続・売却／toushi=投資用
enum PropertyCategory {
  gh
  jigyo
  souzoku
  toushi
  other
}

// 取引態様（売主・代理・媒介（仲介）の別）＝規約別表の必須表示。宅建業法第34条の明示義務にも対応
enum PropertyTradeMode {
  seller
  agent
  broker
}

model Property {
  id            String            @id @default(uuid())
  slug          String            @unique
  status        PropertyStatus    @default(draft)
  dealType      PropertyDealType  @map("deal_type")
  category      PropertyCategory
  // 取引態様は広告許可物件（元付あり）も「媒介」表示（2026-09-01浦松承認③）
  tradeMode     PropertyTradeMode @map("trade_mode")
  title         String
  // 円単位。Int(上限約21.4億)では桁あふれするためBigInt（2026-09-01浦松修正指示2）
  priceYen      BigInt            @map("price_yen")
  priceNote     String?           @map("price_note") // 消費税・非課税、負担金等の注記
  // 町又は字の名称まで（地番なし）＝別表の「物件の所在地」
  locationText  String            @map("location_text")
  // [{ line, station, distanceM }] 徒歩分数は保存せず表示時に80m=1分で算出（規則第9条(9)＝算出根拠を保持）
  access        Json              @default("[]")
  // 種別ごとの必須表示項目（property-validation.ts の discriminated union で検証）
  spec          Json
  images        Json              @default("[]") // [{ url, alt }]
  description   String            @db.Text
  // 情報公開日・情報更新日・次回更新予定日＝インターネット広告の必須表示（別表3-16／5-19／7-19）
  publishedAt   String?           @map("published_at")
  infoUpdatedAt String            @map("info_updated_at")
  nextUpdateAt  String            @map("next_update_at")
  locales       String[]          @default(["ja"])
  translations  Json? // { en?, "zh-tw"?, zh? } 各 PropertyTranslation（任意）
  // ★内部専用（媒介/広告許可の別・元付情報・経緯メモ等）。公開面・JSON-LD・OGPに一切出さない
  // （公開系は toPublicProperty() のホワイトリスト経由のみ＝yotsuba-customer-doc-gate 第5条）
  internal      Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, category])
  @@map("properties")
}

/**
 * 物件の公開内容変更イベント（IndexNow通知の永続キュー）。
 * - 記録（insert）は保存の直後に同期で行う＝プロセス終了で失われない。
 * - 送信（IndexNow）は別途・失敗しても保存を失敗させない（processPendingNotifications）。
 * - urls・contentHash は公開値（toPublicProperty経由）のみ。internal・原本は入らない。
 */
model PropertyPublicationEvent {
  id            String    @id @default(uuid())
  slug          String
  kind          String // "published" | "changed" | "unpublished" | "expired"
  urls          String[]
  contentHash   String?   @map("content_hash")
  notifyStatus  String    @default("pending") @map("notify_status") // "pending" | "sent" | "skipped" | "failed"
  attempts      Int       @default(0)
  lastStatus    Int?      @map("last_status")
  nextAttemptAt DateTime? @map("next_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([notifyStatus, nextAttemptAt])
  @@index([slug])
  @@map("property_publication_events")
}

model Translation {
  locale    String   @id // "ja" | "en" | "zh-tw" | "zh"
  data      Json // ロケール全体を丸ごと（全体上書きと同義に保つ）
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("translations")
}

model AiSetting {
  id        String   @id @default("ai")
  model     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("ai_settings")
}

// 軽量な学区別募集一覧。AD・出典はサーバー内に保持し、公開時に明示的に射影する。
model SchoolRentalFeed {
  provider  String   @id
  payload   Json
  checkedAt DateTime @map("checked_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("school_rental_feeds")
}

// 学区以外の調査 scope（ペット等）の取得バッチ。追記のみ。学区は school_rental_feeds のまま触らない。
// 観測行（payload）は status=verified のときだけ持つ。公開面には確定ログの集計だけを出す。
model RentalSurveyBatch {
  id              String   @id @default(cuid())
  scopeId         String   @map("scope_id")
  scopeVersion    Int      @map("scope_version")
  provider        String
  status          String // verified | incomplete | failed
  failureReason   String?  @map("failure_reason")
  observedFrom    DateTime @map("observed_from")
  observedTo      DateTime @map("observed_to")
  expectedCount   Int?     @map("expected_count")
  recordCount     Int      @map("record_count")
  allPagesChecked Boolean  @map("all_pages_checked")
  payload         Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([scopeId, scopeVersion, provider, createdAt])
  @@map("rental_survey_batches")
}

// 調査 scope ごとの確定ログ。追記のみで、sequence 最大の行が現在の確定。
// (scopeId, scopeVersion, sequence) の一意制約で同時確定を検出する（楽観ロック）。
// 巻き戻しは過去の確定を写した行を足す。snapshot は確定時に計算した対象住戸の照合用最小項目と除外理由別の件数。
model RentalSurveyFinalization {
  id             String   @id @default(cuid())
  scopeId        String   @map("scope_id")
  scopeVersion   Int      @map("scope_version")
  sequence       Int
  batchIds       String[] @map("batch_ids")
  providers      String[]
  dedupVersion   Int      @map("dedup_version")
  observedFrom   DateTime @map("observed_from")
  observedTo     DateTime @map("observed_to")
  snapshot       Json
  rolledBackFrom String?  @map("rolled_back_from")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([scopeId, scopeVersion, sequence])
  @@map("rental_survey_finalizations")
}
